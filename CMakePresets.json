{
  "version": 6,
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "Native, MSVC 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc"
    },
    {
      "name": "wasm",
      "displayName": "WASM, Emscripten (emcmake / EMSDK toolchain)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "msvc", "configurePreset": "msvc", "configuration": "Release" },
    { "name": "wasm", "configurePreset": "wasm" },
    { "name": "msvc-cli", "displayName": "Only insiliscope_cli (no ctest checks)", "configurePreset": "msvc", "configuration": "Release", "targets": ["insiliscope_cli"] },
    { "name": "wasm-viewer", "displayName": "Only the viewer module and the webSMLM block (no WASM tests)", "configurePreset": "wasm", "targets": ["insiliscope_scope_web", "insiliscope_block"] },
    { "name": "lab", "displayName": "JS lab dev server (opens the browser)", "configurePreset": "msvc", "configuration": "Release", "targets": ["lab"] }
  ]
}
